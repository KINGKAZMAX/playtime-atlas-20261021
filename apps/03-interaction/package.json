{
  "name": "loomdeck",
  "version": "1.0.0",
  "private": true,
  "description": "织造车间调度台 LOOMDECK — 原创改编的浏览器端实时织造调度工具",
  "type": "module",
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:tokens": "node scripts/check-tokens-spec.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/clean-dist.mjs",
    "preview": "vite preview --port 4313 --strictPort --host 127.0.0.1",
    "serve": "node scripts/serve.mjs",
    "verify": "node scripts/verify-build.mjs",
    "qa": "node scripts/qa-smoke.mjs"
  },
  "devDependencies": {
    "harfbuzzjs": "^1.6.3",
    "playwright-core": "^1.64.1",
    "subset-font": "^2.9.0",
    "vite": "^5.4.11",
    "wawoff2": "^2.0.1"
  },
  "license": "MIT"
}
