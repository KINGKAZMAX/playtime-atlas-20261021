{
  "name": "chroma-s1-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CHROMA S1 — an original product-launch web page for a fictional pocket colorimeter, built as an adaptation of the craft observed in a popular MiniMax M3.1 Flash web-page case.",
  "scripts": {
    "dev": "vite --port 4311 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4311 --strictPort",
    "typecheck": "tsc --noEmit",
    "qa": "node qa/verify.mjs",
    "qa:ds": "node qa/ds-verify.mjs --out=qa/ds-report.json",
    "qa:d1": "node qa/d1-overlap.mjs --out=qa/d1-final.json",
    "qa:headed": "node qa/verify.mjs --headed"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "^1.64.1",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
