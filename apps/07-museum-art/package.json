{
  "name": "playtime-atlas-art",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "回响电玩馆 / PLAYTIME ATLAS — 原创美术与硬件模型包",
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "fontmanifest": "node scripts/build-font-manifest.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "sync-tokens": "node scripts/sync-ds-tokens.mjs",
    "icons": "node scripts/build-icons.mjs",
    "posters": "node scripts/build-posters.mjs",
    "covers": "node scripts/build-covers.mjs",
    "cases": "node scripts/build-cases.mjs",
    "models": "node scripts/build-models.mjs",
    "assets": "npm run fonts && npm run sync-tokens && npm run tokens && npm run fontmanifest && npm run icons && npm run posters && npm run covers && npm run cases && npm run models && npm run tech && npm run fallback && npm run manifest",
    "dev": "vite --host 127.0.0.1 --port 4327",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327",
    "qa": "node scripts/qa-check.mjs",
    "qa-browser": "node scripts/qa-browser.mjs",
    "qa-subpath": "node scripts/qa-subpath.mjs",
    "tech": "node scripts/build-tech-svg.mjs",
    "fallback": "node scripts/build-fallback.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "render": "node scripts/render.mjs",
    "start": "npm run dev"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^5.4.11"
  }
}
