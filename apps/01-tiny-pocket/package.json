  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
