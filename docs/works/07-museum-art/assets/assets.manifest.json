  "eras": [
    {
      "id": "dawn",
      "index": 1,
      "name": "街机初萌",
      "latin": "ARCADE DAWN",
      "range": "1972 — 1978",
      "tagline": "光点第一次有了边界",
      "story": "最早的电子游戏还只是示波器上跳动的几何光斑。木板、旋钮、发光二极管，被塞进一间间狭小的店面。玩家挤在机器前，盯着两块色块互相追逐——他们还不知道自己正在参与一场关于「画面」的革命。",
      "keywords": [
        "光斑",
        "旋钮",
        "街机店面",
        "木壳",
        "排队"
      ],
      "exhibits": [
        "cabinet-01"
      ],
