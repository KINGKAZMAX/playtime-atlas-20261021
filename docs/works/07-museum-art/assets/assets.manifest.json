    {
      "id": "golden",
      "index": 2,
      "name": "街机黄金",
      "latin": "GOLDEN ARCADE",
      "range": "1978 — 1983",
      "tagline": "投币口之后的黄金年代",
      "story": "街机厅成为城市的夜间客厅。太空侵略者、格斗、赛车，一台台色彩浓烈的机器被投币声点亮。那几年里，游戏设计几乎等于工业设计：一张海报、一段音效，就能决定一款机器的生死。",
      "keywords": [
